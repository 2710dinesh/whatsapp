{
  "expo": {
    "name": "Whatsapp",
    "slug": "Whatsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/whatsapp-logo.png",
    "scheme": "whatsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.Whatsapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/whatsapp-logo.png",
        "backgroundColor": "#25D366"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Whatsapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/**"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3992ea45-e887-4a67-b2e6-e535bff04ac5"
      }
    }
  }
}
